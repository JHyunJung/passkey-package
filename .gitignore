# Worktrees
.worktrees/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Build outputs
build/
out/
target/
dist/
node_modules/
# bootJar 배포 산출물(루트 deploy/ 로 모음)
# 주의: 'deploy/' 처럼 디렉터리 자체를 무시하면 git 이 그 안을 순회하지 않아
# 아래 '!' 예외 규칙이 전혀 동작하지 않는다(gitignore(5): 부모 디렉터리가
# 제외되면 그 안의 파일은 재포함 불가). 그래서 디렉터리가 아닌 '내용물'을 무시한다.
deploy/*
# 단, 컨테이너 배포 자산은 버전 관리한다
# (상위 *.env 규칙으로도 deploy/.env 는 이미 걸리지만, deploy/ 아래 시크릿은
# 의도를 명확히 하기 위해 명시적으로도 남긴다)
!deploy/docker-compose.yml
!deploy/docker-compose.redis.yml
!deploy/.env.example
!deploy/README.md
!deploy/nginx/
deploy/.env

# QA 반입 번들(qa-bundle/) — 스크립트와 문서만 버전 관리한다.
# 이미지 tarball·Docker 정적 바이너리는 700MB 넘고 GitHub 100MB 제한을 위반하며,
# docker save / 공식 배포처에서 언제든 재생성할 수 있으므로 커밋하지 않는다.
# (재생성 방법은 qa-bundle/README.md 참조)
qa-bundle/images/*.tar.gz
qa-bundle/docker-install/*.tgz
qa-bundle/docker-install/docker-compose-linux-*
# 서버에서 생성되는 실제 시크릿
qa-bundle/deploy/.env
# 단, 값이 비어 있는 템플릿은 커밋한다(아래 **/.env.* 규칙의 예외).
# ! 예외는 뒤에 오는 규칙에 다시 걸리면 무효가 되므로, 해당 규칙 뒤에 둔다.

# Eclipse/Gradle 모듈별 컴파일 산출물(IT 실행 등이 생성) — 커밋 금지
bin/
*/bin/

# Gradle
.gradle/
# 테스트용 GRADLE_USER_HOME 산출물(빌드 격리 실행이 생성)
.gradle-home-test/
!gradle-wrapper.jar

# Logs
logs/
*.log

# Secrets
# '*.env' 는 '.env' 와 'prod.env' 를 잡지만 '.env.production' 같은 접미사
# 형태는 못 잡는다(실측 확인 — 이전에 .env.production / rp-app/.env.staging 이
# 추적 대상으로 남아 있었다). 접미사 형태를 일반화해 함께 막는다.
*.env
.env.*
**/.env.*
!qa-bundle/deploy/.env.qa-template
# 단 .env.example 은 시크릿이 아닌 템플릿이므로 커밋한다
!.env.example
!**/.env.example
application-secret*.yml

# Phase 2 admin-ui build outputs
admin-ui/node_modules/
admin-ui/dist/
admin-app/src/main/resources/static/admin/
*.tsbuildinfo
# tsc -b composite output beside vite.config.ts
admin-ui/vite.config.js
admin-ui/vite.config.d.ts
.superpowers/

