<?xml version="1.0" encoding="UTF-8"?>
<!-- 레벨의 단일 출처는 yml logging.level(Spring Boot 가 초기화 직후 적용). 이 파일은
     패턴/인코더/appender 만 정의한다. -->
<configuration>
  <springProperty scope="context" name="rootLevel" source="logging.level.root" defaultValue="INFO"/>

  <!-- Spring Boot 기본 변환어(%clr 등) 등록 — %clr 사용 위해 필수 -->
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <conversionRule conversionWord="msg"
                  class="com.crosscert.passkey.rpapp.web.SecretMaskingConverter"/>
  <conversionRule conversionWord="compactMdc"
                  class="com.crosscert.passkey.rpapp.web.CompactMdcConverter"/>

  <springProfile name="local,dev">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{HH:mm:ss.SSS} %clr(%-5level) %compactMdc %clr(%logger{36}){cyan} - %msg%n%ex</pattern>
      </encoder>
    </appender>
    <root level="${rootLevel}"><appender-ref ref="CONSOLE"/></root>
  </springProfile>

  <springProfile name="qa">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %compactMdc %logger{36} - %msg%n%rEx{8}</pattern>
      </encoder>
    </appender>
    <root level="${rootLevel}"><appender-ref ref="CONSOLE"/></root>
  </springProfile>

  <springProfile name="prod">
    <springProperty scope="context" name="logJson" source="passkey.log.json" defaultValue="false"/>

    <appender name="CONSOLE_TEXT" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %compactMdc %logger{36} - %msg%n%rEx{3}</pattern>
      </encoder>
    </appender>
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <!-- rp-app 이 MDC 에 넣는 키는 이 둘뿐이다
             (TraceIdFilter=traceId, RequestLoggingFilter=actorEmail). -->
        <includeMdcKeyName>traceId</includeMdcKeyName>
        <includeMdcKeyName>actorEmail</includeMdcKeyName>
        <fieldNames>
          <message>[ignore]</message>
        </fieldNames>
        <provider class="com.crosscert.passkey.rpapp.web.RedactingMessageJsonProvider"/>
        <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
          <maxDepthPerThrowable>3</maxDepthPerThrowable>
          <rootCauseFirst>true</rootCauseFirst>
        </throwableConverter>
      </encoder>
    </appender>

    <!-- equalsIgnoreCase: PASSKEY_LOG_JSON=TRUE/True 도 JSON 으로 인식(운영자 오타 방지). -->
    <if condition='property("logJson").equalsIgnoreCase("true")'>
      <then>
        <root level="${rootLevel}"><appender-ref ref="CONSOLE_JSON"/></root>
      </then>
      <else>
        <root level="${rootLevel}"><appender-ref ref="CONSOLE_TEXT"/></root>
      </else>
    </if>
  </springProfile>

  <springProfile name="!local &amp; !dev &amp; !qa &amp; !prod">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{HH:mm:ss.SSS} %-5level %compactMdc %logger{36} - %msg%n</pattern>
      </encoder>
    </appender>
    <root level="${rootLevel}"><appender-ref ref="CONSOLE"/></root>
  </springProfile>
</configuration>
