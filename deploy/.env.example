# deploy/.env.example — 각 서버에서 .env 로 복사해 값을 채운다.
#   cp .env.example .env && chmod 600 .env
#
# ⚠️ MASTER_KEY 는 서버 A·B 가 반드시 동일해야 한다.
#    다르면 한쪽에서 암호화한 데이터를 다른 쪽이 복호화하지 못한다.
#
# 참고: SERVER_FORWARD_HEADERS_STRATEGY 는 주입하지 않는다.
#       passkey-app/admin-app 의 base application.yml 에
#       forward-headers-strategy: framework 가 이미 설정돼 있다.

# ---- 이미지 ----
IMAGE_TAG=0.0.1-SNAPSHOT

# ---- 호스트 포트 (compose 에 기본값이 있어 비워두면 아래 값으로 동작) ----
# nginx 가 잡는 호스트 포트.
#NGINX_HOST_PORT=80
# passkey-app 의 호스트 포트. docker-compose.yml 의 passkey-app ports: 2줄을
# 주석 해제했을 때만 의미가 있다(기본 구성에서는 매핑 자체가 없다).
#PASSKEY_HOST_PORT=8080

# ---- 외부 Oracle DB ----
DB_URL=jdbc:oracle:thin:@//db.example.com:1521/ORCLPDB1
DB_RUNTIME_USER=PSK_APP_RUNTIME_USER
DB_RUNTIME_PASSWORD=
DB_ADMIN_USER=PSK_APP_ADMIN_USER
DB_ADMIN_PASSWORD=
# Flyway 전용(admin-app 만 사용)
DB_OWNER_USER=PSK_APP_OWNER
DB_OWNER_PASSWORD=

# ---- Redis (서버 C) ----
REDIS_HOST=10.0.0.30
REDIS_PORT=6379
REDIS_PASSWORD=
# 아래 3개는 docker-compose.redis.yml(redis 스택) 전용이며 이 앱 스택은 읽지 않는다.
# Redis 를 띄우는 서버 C 에서만 필요하다 — README §3 참고.
# REDIS_BIND_ADDR 은 기본값이 없어(`${VAR:?}`) 비우면 redis 스택이 즉시 기동
# 실패한다(fail-closed). 0.0.0.0 금지 — 서버 C 의 내부 IP 를 쓴다.
#REDIS_BIND_ADDR=
#REDIS_HOST_PORT=6379
#REDIS_MAXMEMORY=512mb

# ---- 시크릿 ----
# openssl rand -base64 32
MASTER_KEY=

# ---- 도메인 ----
PASSKEY_SERVER_NAME=dev-passkey.crosscert.com
ISSUER_BASE=https://dev-passkey.crosscert.com
ADMIN_INVITE_BASE_URL=https://admin.crosscert.com

# ---- admin-app (서버 A 에서만 admin profile 지정) ----
ADMIN_BIND_ADDR=127.0.0.1
ADMIN_HOST_PORT=8081
MDS_LEASE_HOLDER=admin-a

# ---- SMTP (admin-app 전용, 선택) ----
# ⚠️ 미설정 시 LogMailSender 가 선택된다 — 메일이 실제로 발송되지 않고 로그로만
#    남는다. 즉 가입 승인 결과 메일과 비밀번호 재설정 메일이 사용자에게 가지
#    않는다(운영자가 로그를 보고 수동 전달해야 한다).
#    판정 기준은 SPRING_MAIL_HOST 하나다 — 설정되면 SmtpMailSender,
#    비어 있으면 LogMailSender (core MailSenderConfiguration).
#
# ⚠️ 아래 변수들은 docker-compose.yml 의 admin-app 에 패스스루됨.
#    **값을 비워 둔 채(`SPRING_MAIL_HOST=`) 두지 말 것** — 빈 값도 '설정됨' 으로
#    취급돼(@ConditionalOnProperty) SmtpMailSender 가 선택되고 mail health 가
#    DOWN 이 된다. 쓰지 않으면 줄을 주석으로 둔다.
#SPRING_MAIL_HOST=smtp.example.com
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=
#SPRING_MAIL_PASSWORD=
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# 발신 주소. SMTP 활성화 시에만 의미가 있다.
#PASSKEY_MAIL_FROM=no-reply@passkey.local

# ---- actuator 노출 (선택) ----
# 기본은 core application-common.yml 의 health,info 다. prometheus 스크레이프가
# 필요한 배포에서만 아래를 켠다 — 내부망 전용이며, passkey-app 은 Spring Security
# 가 없어 8080 이 무인증이므로 내부망 스크레이퍼만 닿을 수 있게 두어야 한다.
#MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus

# ---- 리소스 ----
PASSKEY_MEM_LIMIT=1g
ADMIN_MEM_LIMIT=1g
RP_MEM_LIMIT=1g
# JVM 옵션. 비워두면 compose 기본값 -XX:MaxRAMPercentage=75 로 동작한다
# (위 *_MEM_LIMIT 을 인식해 힙 상한을 잡는다).
#PASSKEY_JAVA_OPTS=-XX:MaxRAMPercentage=75
#ADMIN_JAVA_OPTS=-XX:MaxRAMPercentage=75
#RP_JAVA_OPTS=-XX:MaxRAMPercentage=75

# ---- QA 전용 (prod 에서는 비워둔다) ----
# prod 는 qa profile 을 지정하지 않아 rp-app 이 기동되지 않는다. 실수로 qa 가
# 섞여도 2차 방어가 있다 — RelayKeyGuard 가 데모 기본 키(빈 값 포함 시 폴백)를
# 거부해 rp-app 이 기동에 실패한다(fail-closed).
RP_SERVER_NAME=rp-dev.crosscert.com
RP_PROFILE=qa
RP_PASSKEY_BASE_URL=http://passkey-app:8080
RP_API_KEY=
RP_TENANT_ID=
# 등록 relay 토큰 HMAC 키 — 데모 기본값이면 rp-app 이 부팅을 거부한다.
# openssl rand -base64 32
RP_RELAY_SECRET=
# 아래 5개는 compose 에 기본값이 있어 비워두면 그 값으로 동작한다.
# cross-origin 웹 SPA 의 origin 목록(쉼표 구분). 비우면 CORS 비활성(같은-origin 만).
# ⚠️ 와일드카드(*) 금지 — 부팅 시 거부된다. passkey-app 테넌트 allowed-origins 와 일치시킬 것.
#RP_CORS_ALLOWED_ORIGINS=https://rp-dev.crosscert.com
# user↔handle↔credential 매핑 JSON 경로. 기본 경로는 rp-data 볼륨에 영속된다.
#RP_APP_USER_STORE_FILE=/app/data/rp-app-users.json
# 네이티브 앱 패스키용 Well-Known 값. 비우면 첨부 샘플 앱(com.crosscert.sample.passkey)
# 기준으로 동작한다. 고객사 앱으로 QA 할 때만 자기 값으로 채운다.
#WK_ANDROID_PACKAGE=com.crosscert.sample.passkey
#WK_ANDROID_SHA256=63:0C:F8:85:C6:9A:80:A0:87:B0:A2:72:83:61:00:29:F8:36:65:FF:EF:8E:FE:71:71:74:13:ED:34:9D:7C:54
#WK_IOS_APPID=LTPC88ZFE8.com.crosscert.sample.passkey
