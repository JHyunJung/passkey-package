# 호스트 nginx 용 설정 (PROXY_MODE=host) — 서버에 이미 설치된 nginx 가 TLS 를 종료한다.
# 직접 고치지 않는다. ./start.sh --nginx-conf 가 deploy/.env 값으로 ${…} 를 채워 출력한다.
#
#   ./start.sh --nginx-conf | sudo tee /etc/nginx/conf.d/passkey-qa.conf > /dev/null
#   sudo nginx -t && sudo systemctl reload nginx
#
# 구성 — 도메인 2개, server 블록 3개:
#   https://<passkey 도메인>          → passkey-app
#   https://<passkey 도메인>:<RP 포트> → rp-app   (RP 는 서브도메인 대신 같은 도메인의 다른 포트)
#   https://<admin 도메인>            → admin-app
#
# 같은 server_name 의 443 블록이 이미 있으면 nginx 가 "conflicting server name" 경고를 내고
# 먼저 읽힌 블록만 쓴다. 그 경우 기존 블록을 지우거나 아래 location 들을 기존 블록으로 옮긴다.
#
# 모든 블록에 같은 헤더 4개를 넘긴다. 셋 다 forward-headers-strategy=framework 라서 이 값으로
# 원래 요청(https, 포트, 클라이언트 IP)을 복원한다.
#   X-Forwarded-Proto $scheme      — TLS 를 여기서 끝내므로 항상 https. 쿠키 Secure·리다이렉트 판정.
#   X-Forwarded-Port  $server_port — RP 처럼 443 이 아닌 포트에서 필수. 없으면 rp-app 이 브라우저
#                                    Origin(https://…:<포트>)을 다른 origin 으로 보고 /passkey/** 를
#                                    403(Invalid CORS request)으로 막는다. X-Forwarded-Proto 가 포트를
#                                    스킴 기본값(443)으로 되돌리므로 Host 에 포트를 실어도 소용없다(실측).
#   X-Forwarded-For   $remote_addr — 이 nginx 가 맨 앞단이므로 클라이언트가 보낸 값을 이어 붙이지 않고
#                                    덮어쓴다(감사 로그·rate-limit IP 위조 방지). 앞에 LB 가 더 있으면
#                                    $proxy_add_x_forwarded_for 로 바꾼다.
#
# 업스트림은 루프백의 고정 주소라 nginx 기동 시 DNS 해석이 없다. 앱이 내려가 있어도 nginx 는
# 뜨고 해당 요청만 502 가 된다.
#
# Rocky(SELinux Enforcing)에서는 nginx 가 업스트림 포트로 나가는 연결이 기본 차단돼 502 가 난다:
#   sudo setsebool -P httpd_can_network_connect 1
# RP 포트가 8443 이 아니면 nginx 가 그 포트에서 listen 하도록 레이블도 붙인다:
#   sudo semanage port -a -t http_port_t -p tcp <RP 포트>

# --- passkey-app : https://${PASSKEY_SERVER_NAME}
server {
    listen 443 ssl;
    server_name ${PASSKEY_SERVER_NAME};

    ssl_certificate     ${TLS_CERT_FILE};
    ssl_certificate_key ${TLS_KEY_FILE};

    # actuator 는 운영 정보를 노출하므로 막는다. 세 블록의 이유는 번들
    # deploy/nginx/nginx.conf 의 주석과 같다 — 특히 정규식은 ';' 경로 파라미터
    # 우회(/actuator;x/health)를 막으므로 지우면 안 된다.
    location ^~ /actuator/ {
        return 404;
    }

    location = /actuator {
        return 404;
    }

    location ~ "^/actuator([/;]|$)" {
        return 404;
    }

    location / {
        proxy_pass http://${PASSKEY_BIND_ADDR}:${PASSKEY_HOST_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port  $server_port;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Real-IP         $remote_addr;
    }
}

# --- rp-app (QA 데모) : https://${PASSKEY_SERVER_NAME}:${RP_PUBLIC_PORT}
# 테넌트 설정: rpId = ${PASSKEY_SERVER_NAME}
#              allowedOrigins = ["https://${PASSKEY_SERVER_NAME}:${RP_PUBLIC_PORT}"]  (포트까지 정확히)
# firewalld 가 켜져 있으면 이 포트를 연다:
#   sudo firewall-cmd --permanent --add-port=${RP_PUBLIC_PORT}/tcp && sudo firewall-cmd --reload
server {
    listen ${RP_PUBLIC_PORT} ssl;
    server_name ${PASSKEY_SERVER_NAME};

    ssl_certificate     ${TLS_CERT_FILE};
    ssl_certificate_key ${TLS_KEY_FILE};

    location / {
        proxy_pass http://${RP_BIND_ADDR}:${RP_HOST_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port  $server_port;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Real-IP         $remote_addr;
    }
}

# --- admin-app (관리 콘솔) : https://${ADMIN_SERVER_NAME}/admin/
# 가입 승인·비밀번호 재설정 메일 링크가 이 주소를 쓴다(ADMIN_INVITE_BASE_URL).
server {
    listen 443 ssl;
    server_name ${ADMIN_SERVER_NAME};

    ssl_certificate     ${ADMIN_TLS_CERT_FILE};
    ssl_certificate_key ${ADMIN_TLS_KEY_FILE};

    # admin-app 은 /actuator/health·info 를 인증 없이 연다(AdminSecurityConfig permitAll,
    # health 는 상세 포함). 외부 도메인으로는 내보내지 않는다. 정규식 하나가 하위 경로·
    # 인덱스·';' 우회를 모두 잡는다(passkey 블록의 앞 두 블록은 명시성용 중첩일 뿐이다).
    location ~ "^/actuator([/;]|$)" {
        return 404;
    }

    location / {
        proxy_pass http://${ADMIN_BIND_ADDR}:${ADMIN_HOST_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port  $server_port;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Real-IP         $remote_addr;
    }
}
