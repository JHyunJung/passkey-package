# ============================================================================
# QA 단일 호스트용 .env 템플릿 (폐쇄망)
#   cp .env.qa-template .env && chmod 600 .env
#
# 저장소의 .env.example 은 서버 A/B/C 분리 구성을 전제로 한다. 이 파일은
# 단일 호스트 QA 에 맞춰 주석을 다시 쓴 것으로, 변수 이름과 의미는 동일하다.
# ============================================================================

# ---- 이미지 ----
# 반입한 이미지 태그와 반드시 일치해야 한다(load-images.sh 로 확인).
IMAGE_TAG=0.0.1-SNAPSHOT

# ---- 외부 Oracle DB ----
# 서비스명 방식(//host:port/service). SID 방식이 아니다.
DB_URL=jdbc:oracle:thin:@//__ORACLE_HOST__:1521/__SERVICE__
DB_RUNTIME_USER=PSK_APP_RUNTIME_USER
DB_RUNTIME_PASSWORD=
DB_ADMIN_USER=PSK_APP_ADMIN_USER
DB_ADMIN_PASSWORD=
# Flyway 전용 — admin-app 에만 주입된다(passkey-app 에 주면 다중 인스턴스가
# 동시에 마이그레이션을 시도한다).
DB_OWNER_USER=PSK_APP_OWNER
DB_OWNER_PASSWORD=

# ---- Redis ----
# ⚠️ 컨테이너 안에서 127.0.0.1 은 "자기 자신"이다. Redis 를 호스트에
#    127.0.0.1 로 바인딩했더라도 여기에는 호스트의 내부 IP 를 적어야 한다.
#    (docker0 게이트웨이 IP: ip -4 addr show docker0 로 확인, 보통 172.17.0.1)
REDIS_HOST=172.17.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 시크릿 ----
# ./gen-secrets.sh --write 로 자동 생성·기록할 수 있다.
# MASTER_KEY 는 base64 디코딩 시 정확히 32바이트여야 앱이 뜬다.
MASTER_KEY=

# ---- 도메인 (§9) ----
# ⚠️ WebAuthn 은 localhost 가 아니면 HTTPS 필수다. 앞단에서 TLS 를 종료하고
#    X-Forwarded-Proto: https 를 전달해야 한다.
PASSKEY_SERVER_NAME=passkey-qa.__내부도메인__
ISSUER_BASE=https://passkey-qa.__내부도메인__
ADMIN_INVITE_BASE_URL=https://passkey-qa.__내부도메인__

# ---- admin-app ----
# 내부망 전용. 외부에 노출하지 않는다.
ADMIN_BIND_ADDR=127.0.0.1
ADMIN_HOST_PORT=8081
MDS_LEASE_HOLDER=admin-qa

# ---- 리소스 ----
PASSKEY_MEM_LIMIT=1g
ADMIN_MEM_LIMIT=1g
RP_MEM_LIMIT=1g

# ---- QA 전용 (rp-app) ----
RP_SERVER_NAME=rp-qa.__내부도메인__
RP_PROFILE=qa
# compose 내부 네트워크 주소. 호스트 도메인이 아니다.
RP_PASSKEY_BASE_URL=http://passkey-app:8080
# ↓ 테넌트/API 키를 만든 뒤에 채운다(가이드 §10). 그 전에는 비워둔다.
RP_API_KEY=
RP_TENANT_ID=
# 데모 기본값이면 rp-app 이 부팅을 거부한다. gen-secrets.sh 가 채워준다.
RP_RELAY_SECRET=
