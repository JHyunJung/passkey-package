# ============================================================================
# QA 단일 호스트용 .env 템플릿 (폐쇄망)
#   cp .env.qa-template .env && chmod 600 .env
#
# 저장소의 .env.example 은 서버 A/B/C 분리 구성을 전제로 한다. 이 파일은
# 단일 호스트 QA 에 맞춰 주석을 다시 쓴 것으로, 변수 이름과 의미는 동일하다.
# ============================================================================

# ---- 이미지 ----
# 반입한 이미지 태그와 반드시 일치해야 한다(load-images.sh 로 확인).
IMAGE_TAG=0.0.1-SNAPSHOT

# ---- 외부 Oracle DB ----
# 서비스명 방식(//host:port/service). SID 방식이 아니다.
DB_URL=jdbc:oracle:thin:@//__ORACLE_HOST__:1521/__SERVICE__
DB_RUNTIME_USER=PSK_APP_RUNTIME_USER
DB_RUNTIME_PASSWORD=
DB_ADMIN_USER=PSK_APP_ADMIN_USER
DB_ADMIN_PASSWORD=
# 스키마 소유자(PSK_APP_OWNER) 계정은 쓰지 않는다 — QA 번들은 Flyway 를 끄고,
# 스키마는 DBA 가 미리 만든다.

# ---- Redis ----
# ⚠️ 컨테이너 안에서 127.0.0.1 은 "자기 자신"이다. Redis 를 호스트에
#    127.0.0.1 로 바인딩했더라도 여기에는 호스트의 내부 IP 를 적어야 한다.
#    (docker0 게이트웨이 IP: ip -4 addr show docker0 로 확인, 보통 172.17.0.1)
REDIS_HOST=172.17.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Redis 가 listen 할 주소. 위 REDIS_HOST 와 같은 값이어야 앱이 도달한다.
# docker-compose.redis.yml 이 기본값 없이 요구하므로 비우면 기동이 실패한다.
# 0.0.0.0 은 외부 노출이라 금지 — 반드시 docker0 등 내부 IP 를 쓴다.
REDIS_BIND_ADDR=172.17.0.1

# ---- 시크릿 ----
# ./gen-secrets.sh --write 로 자동 생성·기록할 수 있다.
# MASTER_KEY 는 base64 디코딩 시 정확히 32바이트여야 앱이 뜬다.
MASTER_KEY=

# ---- nginx 방식 (README "nginx — 두 가지 방식") ----
# host    : 서버에 이미 설치된 nginx 가 TLS 를 종료한다. 번들 nginx 는 띄우지 않고
#           앱을 루프백 포트로만 연다. 호스트 nginx 설정은 ./start.sh --nginx-conf 로 만든다.
# bundled : 번들 nginx 컨테이너가 80/443 과 TLS 를 맡는다
#           (deploy/cert/{fullchain,key}.pem, 서브도메인 2개 — RP_SERVER_NAME 필요).
PROXY_MODE=host

# ---- 도메인 (README "반드시 먼저 해결해야 하는 것 — HTTPS") ----
# ⚠️ WebAuthn 은 localhost 가 아니면 HTTPS 필수다.
PASSKEY_SERVER_NAME=passkey-qa.__내부도메인__
ISSUER_BASE=https://passkey-qa.__내부도메인__
# admin 콘솔 도메인(host 모드). 가입 승인·비밀번호 재설정 메일 링크의 base 도 이 주소다.
# bundled 모드는 admin 을 nginx 뒤에 두지 않으므로 ADMIN_SERVER_NAME 을 비우고,
# 메일을 쓸 때만 ADMIN_INVITE_BASE_URL 을 콘솔 접근 주소로 고친다.
ADMIN_SERVER_NAME=admin-qa.__내부도메인__
ADMIN_INVITE_BASE_URL=https://admin-qa.__내부도메인__

# ---- host 모드: 호스트 nginx 와 맞물리는 값 ----
# ./start.sh --nginx-conf 가 이 값들로 호스트 nginx 설정을 만든다. 바꾸면 다시 만든다.
# RP 데모는 passkey 도메인의 이 포트로 노출한다 — https://<PASSKEY_SERVER_NAME>:<RP_PUBLIC_PORT>
# 8443 은 SELinux 가 nginx 에 기본 허용하는 포트다(다른 값이면 semanage 로 레이블 추가).
RP_PUBLIC_PORT=8443
# 앱 컨테이너가 열리는 호스트 포트(루프백). 호스트 nginx 가 여기로 넘긴다.
# rp-app 기본값이 9090 이 아닌 이유: Rocky 웹 콘솔(cockpit)이 9090 을 쓰는 경우가 있다.
PASSKEY_HOST_PORT=8080
RP_HOST_PORT=19090
# 호스트 nginx 가 쓰는 인증서 경로. 기본값은 Rocky nginx 패키지의 예시 경로다 — 실제 경로로 바꾼다.
TLS_CERT_FILE=/etc/pki/nginx/server.crt
TLS_KEY_FILE=/etc/pki/nginx/private/server.key
# admin 도메인 인증서가 따로 있을 때만 채운다. 비우면 위 인증서를 그대로 쓴다.
ADMIN_TLS_CERT_FILE=
ADMIN_TLS_KEY_FILE=

# ---- admin-app ----
# 루프백에만 연다. host 모드에서는 호스트 nginx 가 admin 도메인으로 받아 이 포트로 넘긴다.
ADMIN_BIND_ADDR=127.0.0.1
ADMIN_HOST_PORT=8081
MDS_LEASE_HOLDER=admin-qa

# ---- 리소스 ----
PASSKEY_MEM_LIMIT=1g
ADMIN_MEM_LIMIT=1g
RP_MEM_LIMIT=1g

# ---- QA 전용 (rp-app) ----
# bundled 모드 전용 — RP 서브도메인(예: rp-qa.내부도메인). host 모드는 비워 둔다
# (RP 는 위 RP_PUBLIC_PORT 로 노출).
RP_SERVER_NAME=
RP_PROFILE=qa
# compose 내부 네트워크 주소. 호스트 도메인이 아니다.
RP_PASSKEY_BASE_URL=http://passkey-app:8080
# ↓ 테넌트/API 키를 만든 뒤에 채운다(README "8. 테넌트 생성"). 그 전에는 비워둔다.
RP_API_KEY=
RP_TENANT_ID=
# 데모 기본값이면 rp-app 이 부팅을 거부한다. gen-secrets.sh 가 채워준다.
RP_RELAY_SECRET=

# ---- actuator 노출 (선택) ----
# 기본은 core application-common.yml 의 health,info 다. prometheus 스크레이프가
# 필요할 때만 아래를 주석 해제한다 — 내부망 전용이며, passkey-app 은 Spring
# Security 가 없어 8080 이 무인증이므로 내부망 스크레이퍼만 닿을 수 있게 둔다.
#MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus
